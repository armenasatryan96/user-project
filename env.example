# Основные настройки приложения
NODE_ENV=development
PORT=3000

# База данных
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/user_project?schema=public"

# JWT настройки
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"
JWT_EXPIRES_IN="1h"

# Bcrypt настройки
BCRYPT_ROUNDS=12
